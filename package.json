    "@fullcalendar/vue3": "^6.1.20",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@vueform/multiselect": "^2.6.11",
    "@vuepic/vue-datepicker": "^12.1.0",
    "axios": "^1.11.0",
    "bootstrap": "^5.3.8",
    "datatables.net": "^2.3.6",
    "datatables.net-fixedheader": "^4.0.6",
    "datatables.net-vue3": "^3.0.4",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.20",
    "dompurify": "^3.3.1",
    "floating-vue": "^5.2.2",
    "sweetalert2": "^11.26.17",
    "tinymce": "^8.5.0",
    "vue3-toastify": "^0.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "sass": "^1.93.2",
    "vite": "^8.2.2",
