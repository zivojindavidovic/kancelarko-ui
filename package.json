{
  "name": "@kancelarko/ui",
  "version": "0.2.0",
  "description": "Kancelarko UI: Vue 3 components, page shell (sidebar, header) and the dark/light theme.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zivojindavidovic/kancelarko-ui.git"
  },
  "homepage": "https://github.com/zivojindavidovic/kancelarko-ui#readme",
  "bugs": {
    "url": "https://github.com/zivojindavidovic/kancelarko-ui/issues"
  },
  "type": "module",
  "main": "./dist/kancelarko-ui.js",
  "module": "./dist/kancelarko-ui.js",
  "style": "./dist/kancelarko-ui.css",
  "exports": {
    ".": {
      "import": "./dist/kancelarko-ui.js"
    },
    "./style.css": "./dist/kancelarko-ui.css",
